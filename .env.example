# Neon (Postgres + Managed Better Auth). Create a `.env.local` with your real
# values (`.env*` is git-ignored). `neon env pull` / `neon deploy` write the
# Neon-managed variables for you.

# Neon Postgres connection (from Neon → Connect). Injected by `neon deploy`.
DATABASE_URL=postgres://...

# Neon Auth base URL for the branch. Injected by `neon deploy`.
NEON_AUTH_BASE_URL=https://...

# Local app secret used to sign cached session cookies. Generate once and keep
# it out of source control:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your_generated_secret

# Canonical application origin used to build absolute links (e.g. invitation
# emails). Set to your production URL when deploying; defaults to localhost.
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Transactional email (Resend) — OPTIONAL. Invitations work without it (the
# shareable invite link is still generated). If both values are set, invitation
# emails are sent automatically; otherwise email delivery is skipped silently.
# RESEND_FROM must be a verified sender/domain in your Resend account.
RESEND_API_KEY=re_...
RESEND_FROM=MANNAT <onboarding@your-domain.example.com>
