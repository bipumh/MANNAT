# Neon (Postgres + Managed Better Auth). Create a `.env.local` with your real
# values (`.env*` is git-ignored). `neon env pull` / `neon deploy` write the
# Neon-managed variables for you.

# Neon Postgres connection (from Neon → Connect). Injected by `neon deploy`.
DATABASE_URL=postgres://...

# Neon Auth base URL for the branch. Injected by `neon deploy`.
NEON_AUTH_BASE_URL=https://...

# Local app secret used to sign cached session cookies. Generate once and keep
# it out of source control:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your_generated_secret
